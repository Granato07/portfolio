# Copie este arquivo para .env (só para testar no seu computador).
# Na Vercel, cadastre as mesmas variáveis em Project > Settings > Environment Variables.
# NUNCA faça commit do .env com valores reais (o .gitignore já bloqueia).

# Formulário de contato (Resend: https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Opcional: remetente de um domínio verificado no Resend
CONTACT_FROM_EMAIL=

# Opcional: token do GitHub sem nenhuma permissão marcada (só leitura pública)
GITHUB_TOKEN=
