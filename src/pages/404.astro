---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { conteudos } from '../conteudo';
const pt = conteudos.pt;
const en = conteudos.en;
---
<Base c={pt} title="404 | Daniel Granato" noindex>
  <main id="conteudo" class="erro">
    <div class="janela" aria-hidden="true">
      <span class="m">GET</span> {Astro.url.pathname}
      <span class="s">404 Not Found</span>
    </div>
    <h1>{pt.naoEncontrado.titulo}</h1>
    <p>{pt.naoEncontrado.texto}</p>
    <p class="en" lang="en">{en.naoEncontrado.titulo} {en.naoEncontrado.texto}</p>
    <div class="acoes">
      <a class="btn btn-primary" href="/"><Icon name="arrow-up-right" size={17} />{pt.naoEncontrado.voltar}</a>
      <a class="btn btn-secondary" href="/en/" lang="en">{en.naoEncontrado.voltar}</a>
    </div>
  </main>
</Base>

<style>
  .erro {
    min-height: 100svh;
    display: grid;
    place-content: center;
    justify-items: start;
    gap: 16px;
    max-width: 640px;
    margin-inline: auto;
    padding: 32px max(var(--gutter), env(safe-area-inset-left, 0px));
  }
  .janela {
    display: grid;
    gap: 4px;
    padding: 14px 18px;
    border: 1px solid var(--code-line);
    border-radius: 14px;
    background: var(--code-bg);
    color: var(--code-text);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .m {
    color: var(--code-ok);
    font-weight: 700;
  }
  .s {
    color: var(--code-err);
    font-weight: 700;
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    font-weight: 750;
    letter-spacing: -0.045em;
  }
  p {
    color: var(--text-2);
  }
  .en {
    color: var(--text-3);
    font-size: 0.92rem;
  }
  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
</style>
