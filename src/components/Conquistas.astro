---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Palavras from './Palavras.astro';
import { foto } from '../lib/fotos';
import type { Conteudo } from '../conteudo';

interface Props {
  c: Conteudo;
}
const { c } = Astro.props;
const q = c.conquistas;
---
<section id="conquistas" class="section section-alt">
  <div class="wrap">
    <header class="section-header reveal" data-anim="words">
      <h2><Palavras texto={q.titulo} /></h2>
      <p class="reveal" data-anim="fade" style="--d: 300ms">{q.subtitulo}</p>
    </header>

    <div class="carrossel" data-carrossel>
      <div class="controles reveal" data-anim="fade">
        <button type="button" class="seta" data-anterior aria-label={c.ui.anterior}><Icon name="chevron-left" size={20} /></button>
        <p class="dica"><Icon name="mouse" size={15} />{c.ui.deslize}</p>
        <button type="button" class="seta" data-proximo aria-label={c.ui.proximo}><Icon name="chevron-right" size={20} /></button>
      </div>

      <ul class="trilho" data-trilho tabindex="0" aria-label={q.titulo}>
        {q.itens.map((item, i) => {
          const img = foto(item.foto);
          return (
            <li class="slide reveal" data-anim="right" style={`--d: ${Math.min(i, 3) * 120}ms`}>
              <article class="conquista" data-brilho>
                <div class="foto">
                  {img ? (
                    <Image src={img} alt={item.titulo} widths={[420, 720]} sizes="(min-width: 1024px) 380px, 85vw" loading="lazy" />
                  ) : (
                    <div class="foto-vazia" aria-hidden="true">
                      <Icon name={item.icone} size={52} />
                    </div>
                  )}
                  <span class="quando">{item.quando}</span>
                </div>
                <div class="corpo">
                  <p class="onde">{item.onde}</p>
                  <h3>{item.titulo}</h3>
                  <p class="texto">{item.texto}</p>
                </div>
              </article>
            </li>
          );
        })}
      </ul>
      <div class="pontos" data-pontos aria-hidden="true">
        {q.itens.map((_, i) => <span class:list={{ ativo: i === 0 }}></span>)}
      </div>
    </div>

    <div class="certificados reveal">
      <div class="cert-head">
        <span class="cert-icone"><Icon name="graduation-cap" size={22} /></span>
        <h3>{q.certificadosTitulo}</h3>
      </div>
      <ul class="cert-lista">
        {q.certificados.map((cert) => (
          <li>
            <div>
              <span class="cert-nome">{cert.nome}</span>
              <span class="cert-meta">{cert.emissor}{cert.ano ? `, ${cert.ano}` : ''}</span>
            </div>
            {cert.url && (
              <a href={cert.url} target="_blank" rel="noopener noreferrer">
                {q.verCertificado}
                <Icon name="arrow-up-right" size={15} />
                <span class="sr-only">{cert.nome} {c.ui.abreNovaAba}</span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .controles {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 16px;
    margin-bottom: 24px;
  }
  .dica {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent-text);
    font-size: 0.88rem;
    font-weight: 550;
  }
  .seta {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text-2);
    cursor: pointer;
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      opacity 0.2s var(--ease);
  }
  .seta:hover:not(:disabled) {
    color: var(--text);
    border-color: var(--accent);
  }
  .seta:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .trilho {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 2px;
    padding: 4px 2px 18px;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .trilho::-webkit-scrollbar {
    display: none;
  }
  .trilho:focus-visible {
    outline-offset: 6px;
  }
  .slide {
    flex: 0 0 min(86%, 360px);
    scroll-snap-align: start;
    display: flex;
  }
  @media (min-width: 1100px) {
    .slide {
      flex-basis: calc((100% - 40px) / 3);
    }
  }

  .conquista {
    display: flex;
    flex-direction: column;
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    background: var(--surface);
    overflow: hidden;
    transition:
      border-color 0.3s var(--ease),
      transform 0.3s var(--ease);
  }
  .conquista:hover {
    border-color: var(--accent-line);
    transform: translateY(-3px);
  }
  .foto {
    position: relative;
    aspect-ratio: 16 / 10;
    max-width: 100%;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }
  .foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .foto-vazia {
    height: 100%;
    display: grid;
    place-items: center;
    color: var(--accent-text);
    background:
      radial-gradient(circle at 50% 55%, rgb(139 92 246 / 0.28), transparent 46%),
      linear-gradient(var(--grid-line) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px) 0 0 / 24px 24px,
      var(--surface-2);
  }
  .foto-vazia :global(.icon) {
    stroke-width: 1.3;
  }
  .quando {
    position: absolute;
    left: 14px;
    bottom: 14px;
    padding: 4px 11px;
    border-radius: 999px;
    background: rgb(124 58 237 / 0.92);
    color: #fff;
    font-size: 0.76rem;
    font-weight: 600;
  }
  .corpo {
    display: grid;
    gap: 6px;
    padding: 20px 22px 24px;
  }
  .onde {
    color: var(--accent-text);
    font-size: 0.84rem;
    font-weight: 600;
  }
  .conquista h3 {
    font-size: 1.22rem;
    letter-spacing: -0.02em;
  }
  .texto {
    margin-top: 2px;
    color: var(--text-2);
    font-size: 0.93rem;
    line-height: 1.6;
  }

  .pontos {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 6px;
  }
  .pontos span {
    width: 8px;
    height: 8px;
    border-radius: 99px;
    background: var(--border-strong);
    transition:
      width 0.25s var(--ease),
      background-color 0.25s var(--ease);
  }
  .pontos .ativo {
    width: 24px;
    background: var(--accent);
  }

  .certificados {
    max-width: 820px;
    margin: clamp(56px, 7vw, 80px) auto 0;
    padding: clamp(20px, 3vw, 30px);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    background:
      radial-gradient(100% 120% at 100% 0%, rgb(124 58 237 / 0.1), transparent 55%),
      var(--surface);
  }
  .cert-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 8px;
  }
  .cert-icone {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-m);
    background: var(--accent-soft);
    color: var(--accent-text);
  }
  .cert-head h3 {
    font-size: 1.2rem;
  }
  .cert-lista li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }
  .cert-lista li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .cert-lista li > div {
    flex: 1;
    display: grid;
  }
  .cert-nome {
    font-weight: 600;
  }
  .cert-meta {
    color: var(--text-3);
    font-size: 0.86rem;
  }
  .cert-lista a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--accent-text);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
  }
</style>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-carrossel]');
  if (raiz) {
    const trilho = raiz.querySelector<HTMLElement>('[data-trilho]')!;
    const ant = raiz.querySelector<HTMLButtonElement>('[data-anterior]')!;
    const prox = raiz.querySelector<HTMLButtonElement>('[data-proximo]')!;
    const pontos = [...raiz.querySelectorAll<HTMLElement>('[data-pontos] span')];
    const slides = [...trilho.children] as HTMLElement[];

    const passo = () => (slides[0]?.getBoundingClientRect().width ?? 300) + 20;
    ant.addEventListener('click', () => trilho.scrollBy({ left: -passo(), behavior: 'smooth' }));
    prox.addEventListener('click', () => trilho.scrollBy({ left: passo(), behavior: 'smooth' }));

    const atualizar = () => {
      const max = trilho.scrollWidth - trilho.clientWidth;
      ant.disabled = trilho.scrollLeft <= 4;
      prox.disabled = trilho.scrollLeft >= max - 4;
      const atual = max <= 0 ? 0 : Math.round((trilho.scrollLeft / max) * (slides.length - 1));
      pontos.forEach((p, i) => p.classList.toggle('ativo', i === atual));
    };
    trilho.addEventListener('scroll', atualizar, { passive: true });
    window.addEventListener('resize', atualizar);
    atualizar();
  }
</script>
