---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Palavras from './Palavras.astro';
import TechIcon from './TechIcon.astro';
import ProjectCover from './ProjectCover.astro';
import { foto } from '../lib/fotos';
import type { Conteudo } from '../conteudo';

interface Props {
  c: Conteudo;
}
const { c } = Astro.props;
const p = c.projetos;
const maxTags = (destaque?: boolean) => (destaque ? 5 : 3);
---
<section id="projetos" class="section section-alt">
  <div class="wrap">
    <header class="section-header reveal" data-anim="words">
      <h2><Palavras texto={p.titulo} /></h2>
      <p class="reveal" data-anim="fade" style="--d: 300ms">{p.subtitulo}</p>
    </header>

    <div class="tabs reveal" data-anim="fade" role="group" aria-label={p.titulo} data-filtros data-um={p.contagemUm} data-varios={p.contagemVarios}>
      {p.filtros.map((f, i) => (
        <button type="button" class="tab" data-filtro={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>{f.rotulo}</button>
      ))}
    </div>
    <p class="sr-only" aria-live="polite" data-contagem></p>

    <ul class="grade" data-lista>
      {p.itens.map((proj, i) => {
        const img = foto(proj.foto);
        const max = maxTags(proj.destaque);
        const extras = proj.stack.length - max;
        return (
          <li class:list={['item reveal', { destaque: proj.destaque }]} style={`--d: ${(i % 2) * 130}ms`} data-categorias={proj.categorias.join(' ')}>
            <article class="card">
              <div class="card-capa">
                {img ? <Image src={img} alt="" widths={[480, 800]} sizes="(min-width: 1024px) 560px, 100vw" loading="lazy" /> : <ProjectCover capa={proj.capa} grande={proj.destaque} />}
              </div>
              <div class="card-corpo">
                <p class="card-meta">
                  <span>{proj.contexto}</span>
                  {proj.periodo && <span>{proj.periodo}</span>}
                </p>
                <h3>{proj.nome}</h3>
                <p class="card-resumo">{proj.resumo}</p>
                <ul class="tags">
                  {proj.stack.slice(0, max).map((s) => <li class="chip">{s}</li>)}
                  {extras > 0 && <li class="chip">+{extras}</li>}
                </ul>
                <div class="card-acoes">
                  <button type="button" class="btn btn-secondary btn-sm" data-abrir={proj.id} aria-haspopup="dialog">
                    {c.ui.detalhes}
                  </button>
                  {proj.repositorio && (
                    <a class="link" href={proj.repositorio} target="_blank" rel="noopener noreferrer">
                      <Icon name="github" size={16} />
                      {c.ui.codigo}
                      <span class="sr-only">{proj.nome} {c.ui.abreNovaAba}</span>
                    </a>
                  )}
                  {proj.link && (
                    <a class="link" href={proj.link.url} target="_blank" rel="noopener noreferrer">
                      <Icon name="arrow-up-right" size={16} />
                      {proj.link.rotulo}
                      <span class="sr-only">{c.ui.abreNovaAba}</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          </li>
        );
      })}
    </ul>
  </div>

  {p.itens.map((proj) => (
    <dialog class="modal" id={`projeto-${proj.id}`} aria-labelledby={`projeto-${proj.id}-titulo`} data-modal>
      <div class="modal-caixa">
        <button type="button" class="modal-fechar" data-fechar aria-label={c.ui.fechar}><Icon name="x" size={20} /></button>
        <div class="modal-capa"><ProjectCover capa={proj.capa} grande /></div>
        <div class="modal-corpo">
          <p class="card-meta">
            <span>{proj.contexto}</span>
            {proj.periodo && <span>{proj.periodo}</span>}
          </p>
          <h3 id={`projeto-${proj.id}-titulo`}>{proj.nome}</h3>
          <p class="modal-resumo">{proj.resumo}</p>

          <h4>{p.oQueFiz}</h4>
          <ul class="detalhes">
            {proj.detalhes.map((d) => <li><Icon name="check" size={16} />{d}</li>)}
          </ul>

          <h4>{p.tecnologias}</h4>
          <ul class="stack">
            {proj.stack.map((s) => <li><TechIcon nome={s} size={18} />{s}</li>)}
          </ul>

          {(proj.repositorio || proj.link) && (
            <div class="modal-acoes">
              {proj.repositorio && (
                <a class="btn btn-primary" href={proj.repositorio} target="_blank" rel="noopener noreferrer">
                  <Icon name="github" size={17} />
                  {c.ui.codigo}
                  <span class="sr-only">{c.ui.abreNovaAba}</span>
                </a>
              )}
              {proj.link && (
                <a class="btn btn-secondary" href={proj.link.url} target="_blank" rel="noopener noreferrer">
                  <Icon name="arrow-up-right" size={17} />
                  {proj.link.rotulo}
                  <span class="sr-only">{c.ui.abreNovaAba}</span>
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    </dialog>
  ))}
</section>

<style>
  .grade {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 22px;
  }
  .item {
    flex: 0 1 100%;
    display: flex;
  }
  .item[hidden] {
    display: none;
  }
  @media (min-width: 700px) {
    .item {
      flex-basis: calc((100% - 22px) / 2);
    }
  }


  .card {
    display: flex;
    flex-direction: column;
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    transition: border-color 0.15s ease;
  }
  .card:hover {
    border-color: var(--border-strong);
  }
  .card-capa {
    position: relative;
    height: 206px;
    border-bottom: 1px solid var(--border);
  }
  .destaque .card-capa {
    height: 240px;
  }
  .card-capa :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .estrela {
    position: absolute;
    top: 12px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: var(--r-s);
    background: rgb(90 63 168 / 0.95);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
  }
  .card-corpo {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 22px 22px;
  }
  .card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    color: var(--text-3);
    font-size: 0.82rem;
  }
  .card-meta span + span::before {
    content: '';
    display: inline-block;
    width: 3px;
    height: 3px;
    margin-right: 10px;
    border-radius: 50%;
    background: currentColor;
    vertical-align: middle;
  }
  .card h3 {
    font-size: 1.3rem;
    letter-spacing: -0.025em;
  }
  .card-resumo {
    color: var(--text-2);
    font-size: 0.94rem;
    line-height: 1.6;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }
  .card-acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    margin-top: auto;
    padding-top: 12px;
  }
  .link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text-2);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }
  .link:hover {
    color: var(--accent-text);
  }

  /* Modal de detalhes */
  .modal {
    width: min(760px, calc(100% - 32px));
    max-height: calc(100dvh - 48px);
    margin: auto;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-xl);
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 40px 100px -30px rgb(0 0 0 / 0.8);
    overflow: hidden;
  }
  .modal[open] {
    animation: abre 0.28s var(--ease);
  }
  .modal::backdrop {
    background: rgb(5 5 8 / 0.7);
    backdrop-filter: blur(6px);
  }
  @keyframes abre {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
  }
  .modal-caixa {
    position: relative;
    max-height: calc(100dvh - 48px);
    overflow-y: auto;
  }
  .modal-fechar {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--r-m);
    border: 1px solid #2c2c38;
    background: rgb(12 12 17 / 0.85);
    color: #e6e6ee;
    cursor: pointer;
  }
  .modal-fechar:hover {
    border-color: var(--accent);
  }
  .modal-capa {
    height: 250px;
    border-bottom: 1px solid var(--border);
  }
  .modal-corpo {
    padding: 26px clamp(20px, 4vw, 34px) 32px;
  }
  .modal-corpo h3 {
    margin-top: 6px;
    font-size: clamp(1.5rem, 3.2vw, 2rem);
    letter-spacing: -0.03em;
  }
  .modal-resumo {
    margin-top: 10px;
    color: var(--text-2);
    font-size: 1.02rem;
  }
  .modal-corpo h4 {
    margin: 26px 0 12px;
    font-size: 0.9rem;
    font-weight: 650;
  }
  .detalhes {
    display: grid;
    gap: 10px;
    color: var(--text-2);
    font-size: 0.95rem;
  }
  .detalhes li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 10px;
    align-items: start;
  }
  .detalhes :global(.icon) {
    margin-top: 3px;
    color: var(--accent-text);
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .stack li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: var(--r-m);
    background: var(--bg-alt);
    color: var(--text);
    font-size: 0.88rem;
    font-weight: 550;
  }
  .stack :global(.tech-icon),
  .stack :global(.tech-sigla) {
    color: var(--text-2);
  }
  .modal-acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
</style>

<script>
  // Filtros
  const grupo = document.querySelector<HTMLElement>('[data-filtros]');
  const itens = [...document.querySelectorAll<HTMLElement>('[data-lista] > li')];
  const contagem = document.querySelector<HTMLElement>('[data-contagem]');

  grupo?.addEventListener('click', (e) => {
    const botao = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filtro]');
    if (!botao) return;
    const filtro = botao.dataset.filtro ?? 'todos';
    grupo.querySelectorAll('[data-filtro]').forEach((b) => b.setAttribute('aria-pressed', String(b === botao)));
    let n = 0;
    itens.forEach((item) => {
      const mostra = filtro === 'todos' || (item.dataset.categorias ?? '').split(' ').includes(filtro);
      item.hidden = !mostra;
      if (mostra) n++;
    });
    if (contagem) contagem.textContent = (n === 1 ? grupo.dataset.um : grupo.dataset.varios)?.replace('{n}', String(n)) ?? '';
  });

  // Modais de detalhes
  let origem: HTMLElement | null = null;
  document.querySelectorAll<HTMLButtonElement>('[data-abrir]').forEach((b) =>
    b.addEventListener('click', () => {
      const modal = document.getElementById(`projeto-${b.dataset.abrir}`) as HTMLDialogElement | null;
      if (!modal) return;
      origem = b;
      modal.showModal();
      document.documentElement.style.overflow = 'hidden';
    }),
  );
  document.querySelectorAll<HTMLDialogElement>('[data-modal]').forEach((modal) => {
    modal.querySelector('[data-fechar]')?.addEventListener('click', () => modal.close());
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close(); // clique fora da caixa
    });
    modal.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      origem?.focus();
    });
  });
</script>
