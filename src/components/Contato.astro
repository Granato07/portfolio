---
import Icon from './Icon.astro';
import Palavras from './Palavras.astro';
import { contatos } from '../data/comum';
import type { Conteudo } from '../conteudo';

interface Props {
  c: Conteudo;
}
const { c } = Astro.props;
const k = c.contato;
const canais = [
  { id: 'email', icone: 'mail', rotulo: k.canais.email, valor: contatos.email, dica: k.dicas.email, href: `mailto:${contatos.email}`, externo: false },
  { id: 'whatsapp', icone: 'whatsapp', rotulo: k.canais.whatsapp, valor: contatos.whatsappExibicao, dica: k.dicas.whatsapp, href: `https://wa.me/${contatos.whatsappNumero}`, externo: true },
  { id: 'linkedin', icone: 'linkedin', rotulo: k.canais.linkedin, valor: contatos.linkedinExibicao, dica: k.dicas.linkedin, href: contatos.linkedin, externo: true },
  { id: 'github', icone: 'github', rotulo: k.canais.github, valor: contatos.githubUsuario, dica: k.dicas.github, href: contatos.github, externo: true },
];
---
<section id="contato" class="section">
  <div class="wrap">
    <header class="section-header reveal" data-anim="words">
      <h2><Palavras texto={k.titulo} /></h2>
      <p class="reveal" data-anim="fade" style="--d: 300ms">{k.subtitulo}</p>
    </header>

    <ul class="canais">
      {canais.map((canal, i) => (
        <li class="reveal" style={`--d: ${i * 90}ms`}>
          <a class="canal" href={canal.href} target={canal.externo ? '_blank' : undefined} rel={canal.externo ? 'noopener noreferrer' : undefined}>
            <span class="canal-icone"><Icon name={canal.icone} size={22} /></span>
            <span class="canal-rotulo">{canal.rotulo}</span>
            <span class="canal-valor">{canal.valor}</span>
            <span class="canal-dica">{canal.dica}</span>
            <Icon name="arrow-up-right" size={18} class="canal-seta" />
            {canal.externo && <span class="sr-only">{c.ui.abreNovaAba}</span>}
          </a>
          {canal.id === 'email' && (
            <button type="button" class="copiar" data-copiar={contatos.email} data-ok={c.ui.copiado} aria-label={c.ui.copiar}>
              <Icon name="copy" size={15} class="i-copiar" />
              <Icon name="check" size={15} class="i-ok" />
            </button>
          )}
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .canais {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 16px;
  }
  .canais li {
    position: relative;
  }
  .canal {
    position: relative;
    display: grid;
    gap: 2px;
    height: 100%;
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    background: var(--surface);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .canal:hover {
    border-color: var(--border-strong);
  }
  .canal-icone {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin-bottom: 16px;
    border-radius: var(--r-m);
    background: var(--accent-soft);
    color: var(--accent-text);
  }
  .canal-rotulo {
    font-weight: 650;
    font-size: 1.02rem;
  }
  .canal-valor {
    color: var(--text-2);
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }
  .canal-dica {
    margin-top: 4px;
    color: var(--text-3);
    font-size: 0.8rem;
  }
  .canal :global(.canal-seta) {
    position: absolute;
    top: 22px;
    right: 22px;
    color: var(--text-3);
    transition:
      transform 0.25s var(--ease),
      color 0.25s var(--ease);
  }
  .canal:hover :global(.canal-seta) {
    color: var(--accent-text);
    transform: translate(2px, -2px);
  }
  @media (max-width: 640px) {
    .canal {
      grid-template-columns: auto 1fr;
      column-gap: 16px;
      padding: 18px 56px 18px 18px;
    }
    .canal-icone {
      grid-row: span 3;
      margin-bottom: 0;
      align-self: center;
    }
    .canal :global(.canal-seta) {
      top: 50%;
      right: 18px;
      translate: 0 -50%;
    }
    .canais li:first-child .canal {
      padding-right: 100px;
    }
    .copiar {
      right: 48px !important;
      bottom: auto !important;
      top: 50%;
      translate: 0 -50%;
    }
  }
  .copiar {
    position: absolute;
    right: 18px;
    bottom: 18px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text-2);
    cursor: pointer;
  }
  .copiar:hover {
    color: var(--text);
    border-color: var(--accent-line);
  }
  .copiar :global(.icon) {
    grid-area: 1 / 1;
  }
  .copiar :global(.i-ok),
  .copiar[data-copiado] :global(.i-copiar) {
    visibility: hidden;
  }
  .copiar[data-copiado] :global(.i-ok) {
    visibility: visible;
    color: var(--ok);
  }
</style>

<script>
  // Copiar e-mail
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((b) =>
    b.addEventListener('click', async () => {
      const texto = b.dataset.copiar ?? '';
      try {
        await navigator.clipboard.writeText(texto);
      } catch {
        const area = document.createElement('textarea');
        area.value = texto;
        document.body.appendChild(area);
        area.select();
        try {
          document.execCommand('copy');
        } catch {
          /* sem área de transferência: o e-mail continua visível no cartão */
        }
        area.remove();
      }
      b.setAttribute('data-copiado', '');
      const rotulo = b.getAttribute('aria-label');
      b.setAttribute('aria-label', b.dataset.ok ?? '');
      window.setTimeout(() => {
        b.removeAttribute('data-copiado');
        if (rotulo) b.setAttribute('aria-label', rotulo);
      }, 2000);
    }),
  );
</script>
