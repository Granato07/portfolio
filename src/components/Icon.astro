---
import { icons, marcas } from '../lib/icons';

interface Props {
  name: string;
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 18, label, class: className } = Astro.props;
const marca = marcas[name];
const role = label ? 'img' : undefined;
const hidden = label ? undefined : ('true' as const);
---
{marca ? (
  <svg
    class:list={['icon', className]}
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="currentColor"
    fill-rule={name === 'linkedin' ? 'evenodd' : undefined}
    role={role}
    aria-label={label}
    aria-hidden={hidden}
  >
    <path d={marca} />
  </svg>
) : (
  <svg
    class:list={['icon', className]}
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    role={role}
    aria-label={label}
    aria-hidden={hidden}
    set:html={icons[name] ?? ''}
  />
)}
