---
import Icon from './Icon.astro';
import ApiConsole from './ApiConsole.astro';
import Palavras from './Palavras.astro';
import { perfil, contatos } from '../data/comum';
import type { Conteudo } from '../conteudo';

interface Props {
  c: Conteudo;
}
const { c } = Astro.props;
const [primeiro, ...resto] = perfil.nome.split(' ');
const sociais = [
  { href: contatos.github, icone: 'github', rotulo: 'GitHub', externo: true },
  { href: contatos.linkedin, icone: 'linkedin', rotulo: 'LinkedIn', externo: true },
  { href: `https://wa.me/${contatos.whatsappNumero}`, icone: 'whatsapp', rotulo: 'WhatsApp', externo: true },
  { href: `mailto:${contatos.email}`, icone: 'mail', rotulo: c.contato.canais.email, externo: false },
];
---
<section id="inicio" class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="grid"></div>
    <div class="luz" data-luz></div>
    <div class="glow glow-a"></div>
    <div class="glow glow-b"></div>
  </div>

  <div class="wrap hero-grid">
    <div class="hero-text">
      <p class="selo">
        <span class="selo-dot" aria-hidden="true"></span>
        <span data-relogio={c.hero.relogio} data-lang={c.htmlLang}>{c.hero.selo}</span>
      </p>
      <h1>
        <span class="nome"><Palavras texto={primeiro} /></span>
        <span class="nome"><Palavras texto={resto.join(' ')} inicio={1} /></span>
        <span class="sr-only">, </span>
        <span class="cargo">{c.hero.cargo}</span>
      </h1>
      <p class="texto">{c.hero.texto}</p>

      <div class="cta">
        <a class="btn btn-primary" href="#projetos">
          {c.hero.ctaPrincipal}
          <Icon name="arrow-right" size={17} />
        </a>
        <a class="btn btn-secondary" href={perfil.curriculo[c.lang]} download>
          <Icon name="download" size={17} />
          {c.hero.ctaSecundario}
        </a>
      </div>

      <ul class="sociais">
        {sociais.map((s) => (
          <li>
            <a class="icon-btn" href={s.href} target={s.externo ? '_blank' : undefined} rel={s.externo ? 'noopener noreferrer' : undefined}>
              <Icon name={s.icone} size={18} label={s.rotulo} />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="hero-console">
      <div data-tilt><ApiConsole c={c} /></div>
    </div>
  </div>

  <a class="rolar" href="#sobre">
    <span class="rato" aria-hidden="true"><span></span></span>
    <span class="sr-only">{c.hero.rolar}</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: calc(var(--header-h) + env(safe-area-inset-top, 0px) + clamp(48px, 9vw, 104px));
    padding-bottom: clamp(88px, 11vw, 136px);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 56px 56px;
    background-position: center top;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, #000 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, #000 40%, transparent 100%);
  }
  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
  }
  .glow-a {
    animation: deriva 16s ease-in-out infinite alternate;
    width: 560px;
    height: 560px;
    right: -120px;
    top: -140px;
    background: rgb(124 58 237 / 0.17);
  }
  .glow-b {
    animation: deriva 20s ease-in-out -6s infinite alternate-reverse;
    width: 420px;
    height: 420px;
    left: -160px;
    bottom: -120px;
    background: rgb(168 85 247 / 0.12);
  }
  :global(:root[data-theme='light']) .glow-a {
    background: rgb(124 58 237 / 0.14);
  }
  :global(:root[data-theme='light']) .glow-b {
    background: rgb(168 85 247 / 0.08);
  }

  @keyframes deriva {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    50% {
      transform: translate3d(-60px, 40px, 0) scale(1.08);
    }
    100% {
      transform: translate3d(30px, 70px, 0) scale(0.95);
    }
  }

  .hero-grid {
    display: grid;
    gap: 56px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
      gap: 64px;
    }
  }

  .selo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }
  .selo-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px rgb(139 92 246 / 0.2);
    animation: pulso 2.6s var(--ease) infinite;
  }
  @keyframes pulso {
    50% {
      box-shadow: 0 0 0 7px rgb(139 92 246 / 0);
    }
  }

  h1 {
    margin-top: 26px;
    font-weight: 750;
    letter-spacing: -0.055em;
    line-height: 0.92;
  }
  .nome {
    display: block;
    font-size: clamp(3.4rem, 9.6vw, 6.9rem);
    padding-bottom: 0.06em;
    color: var(--text);
  }
  .nome :global(.w > span) {
    animation: sobe 1.1s var(--ease-out) both;
    animation-delay: calc(0.15s + var(--i, 0) * 0.12s);
  }
  @keyframes sobe {
    from {
      transform: translateY(105%);
    }
  }
  .luz {
    position: absolute;
    inset: 0;
    background: radial-gradient(520px circle at var(--hx, 70%) var(--hy, 30%), rgb(139 92 246 / 0.13), transparent 60%);
    transition: background 0.2s linear;
  }
  .cargo {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 24px;
    font-size: clamp(1.25rem, 2.3vw, 1.6rem);
    font-weight: 550;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--text);
  }
  .cargo::before {
    content: '';
    width: 32px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--accent), #c084fc);
  }
  .texto {
    margin-top: 18px;
    max-width: 50ch;
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-2);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }
  .sociais {
    display: flex;
    gap: 10px;
    margin-top: 30px;
  }

  .hero-console {
    position: relative;
  }
  .hero-console::before {
    content: '';
    position: absolute;
    inset: 10% 6% -4%;
    z-index: -1;
    border-radius: 40px;
    background: radial-gradient(closest-side, rgb(124 58 237 / 0.45), transparent);
    filter: blur(40px);
  }

  .rolar {
    position: absolute;
    left: 50%;
    bottom: 28px;
    translate: -50% 0;
    display: none;
    padding: 6px;
    color: var(--text-3);
  }
  @media (min-width: 1024px) and (min-height: 760px) {
    .rolar {
      display: block;
    }
  }
  .rato {
    display: block;
    width: 22px;
    height: 34px;
    border: 1.6px solid currentColor;
    border-radius: 12px;
  }
  .rato span {
    display: block;
    width: 3px;
    height: 7px;
    margin: 6px auto 0;
    border-radius: 2px;
    background: var(--accent);
    animation: roda 1.8s var(--ease) infinite;
  }
  @keyframes roda {
    0% {
      opacity: 0;
      transform: translateY(-2px);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(9px);
    }
  }

  /* Entrada da página */
  .hero-text > *,
  .hero-console {
    animation: entra 0.8s var(--ease) both;
  }
  .hero-text > :nth-child(2) {
    animation-delay: 0.07s;
  }
  .hero-text > :nth-child(3) {
    animation-delay: 0.14s;
  }
  .hero-text > :nth-child(n + 4) {
    animation-delay: 0.21s;
  }
  .hero-console {
    animation-delay: 0.3s;
  }
  .hero-text > :nth-child(2) {
    animation: none;
  }
  @keyframes entra {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glow,
    .nome :global(.w > span) {
      animation: none;
    }
  }

  @media (max-width: 520px) {
    .cta .btn {
      flex: 1 1 100%;
    }
  }
</style>
