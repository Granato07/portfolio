---
import ApiConsole from './ApiConsole.astro';
import Palavras from './Palavras.astro';
import { perfil, contatos } from '../data/comum';
import type { Conteudo } from '../conteudo';

interface Props {
  c: Conteudo;
}
const { c } = Astro.props;
const [primeiro, ...resto] = perfil.nome.split(' ');
const sociais = [
  { href: contatos.github, icone: 'github', rotulo: 'GitHub', externo: true },
  { href: contatos.linkedin, icone: 'linkedin', rotulo: 'LinkedIn', externo: true },
  { href: `https://wa.me/${contatos.whatsappNumero}`, icone: 'whatsapp', rotulo: 'WhatsApp', externo: true },
  { href: `mailto:${contatos.email}`, icone: 'mail', rotulo: c.contato.canais.email, externo: false },
];
---
<section id="inicio" class="hero">
  <div class="wrap hero-grid">
    <div class="hero-text">
      <h1>
        <span class="nome"><Palavras texto={primeiro} /></span>
        <span class="nome"><Palavras texto={resto.join(' ')} inicio={1} /></span>
        <span class="sr-only">, </span>
        <span class="cargo">{c.hero.cargo}</span>
      </h1>
      <p class="texto">{c.hero.texto}</p>

      <div class="cta">
        <a class="btn btn-primary" href="#projetos">
          {c.hero.ctaPrincipal}
        </a>
        <a class="link-texto" href={perfil.curriculo[c.lang]} download>
          {c.hero.ctaSecundario}
        </a>
      </div>

      <ul class="sociais">
        {sociais.map((s) => (
          <li>
            <a href={s.href} target={s.externo ? '_blank' : undefined} rel={s.externo ? 'noopener noreferrer' : undefined}>{s.rotulo}</a>
          </li>
        ))}
      </ul>
    </div>

    <div class="hero-console">
      <ApiConsole c={c} />
    </div>
  </div>

</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: calc(var(--header-h) + env(safe-area-inset-top, 0px) + clamp(48px, 9vw, 104px));
    padding-bottom: clamp(88px, 11vw, 136px);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    gap: 56px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
      gap: 64px;
    }
  }


  h1 {
    margin-top: 0;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }
  .nome {
    display: block;
    font-size: clamp(3.2rem, 8.4vw, 6rem);
    padding-bottom: 0.06em;
    color: var(--text);
  }
  .nome :global(.w > span) {
    animation: sobe 1.1s var(--ease-out) both;
    animation-delay: calc(0.15s + var(--i, 0) * 0.12s);
  }
  @keyframes sobe {
    from {
      transform: translateY(105%);
    }
  }
  .cargo {
    display: flex;
    align-items: center;
    margin-top: 24px;
    font-size: clamp(1.25rem, 2.3vw, 1.6rem);
    font-weight: 550;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--text);
  }
  .texto {
    margin-top: 18px;
    max-width: 50ch;
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-2);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }
  .sociais {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin-top: 28px;
  }
  .sociais a {
    color: var(--text-2);
    font-size: 0.925rem;
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 5px;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }
  .sociais a:hover {
    color: var(--text);
    text-decoration-color: currentColor;
  }

  .hero-console {
    position: relative;
  }

  .rolar {
    position: absolute;
    left: 50%;
    bottom: 28px;
    translate: -50% 0;
    display: none;
    padding: 6px;
    color: var(--text-3);
  }
  @media (min-width: 1024px) and (min-height: 760px) {
    .rolar {
      display: block;
    }
  }
  .rato {
    display: block;
    width: 22px;
    height: 34px;
    border: 1.6px solid currentColor;
    border-radius: 12px;
  }
  .rato span {
    display: block;
    width: 3px;
    height: 7px;
    margin: 6px auto 0;
    border-radius: 2px;
    background: var(--accent);
    animation: roda 1.8s var(--ease) infinite;
  }
  @keyframes roda {
    0% {
      opacity: 0;
      transform: translateY(-2px);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(9px);
    }
  }

  /* Entrada da página */
  .hero-text > *,
  .hero-console {
    animation: entra 0.8s var(--ease) both;
  }
  .hero-text > :nth-child(2) {
    animation-delay: 0.07s;
  }
  .hero-text > :nth-child(3) {
    animation-delay: 0.14s;
  }
  .hero-text > :nth-child(n + 4) {
    animation-delay: 0.21s;
  }
  .hero-console {
    animation-delay: 0.3s;
  }
  .hero-text > :nth-child(2) {
    animation: none;
  }
  @keyframes entra {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nome :global(.w > span) {
      animation: none;
    }
  }

  @media (max-width: 520px) {
    .cta .btn {
      flex: 1 1 100%;
    }
  }
</style>
